; Engine configuration file.
config_version=5

[application]

config/name="DI2 Gore Lab"
config/description="Personal test bed: Dead Island 2 style FLESH gore + zombies, recreated with a Rust core."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
textures/default_filters/anisotropic_filtering_level=3

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="zombie"
3d_physics/layer_4="hitbox"
3d_physics/layer_5="debris"

[shader_globals]

di2_fluid_map={
"type": "sampler2D",
"value": ""
}
di2_fluid_area={
"type": "vec4",
"value": Vector4(-25.6, -25.6, 51.2, 51.2)
}
di2_fluid_color={
"type": "vec4",
"value": Vector4(0.88, 0.195553, 0.146666, 0.02)
}
di2_fluid_params={
"type": "vec4",
"value": Vector4(10, 0.08, 0.35, 0.64)
}
di2_fluid_height={
"type": "vec2",
"value": Vector2(-10, 30)
}
di2_fluid_fuel={
"type": "vec4",
"value": Vector4(0.642579, 0.574219, 0.65625, 0)
}
di2_fluid_fuel_edge={
"type": "vec4",
"value": Vector4(0.642579, 0.574219, 0.65625, 0)
}
di2_fluid_water={
"type": "vec4",
"value": Vector4(0.95, 0.95, 0.95, 0)
}
