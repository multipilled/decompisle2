#!/bin/sh
# Blocks commits that include game data, decompiled code or private strings. Enable with:
#   git config core.hooksPath .githooks
# Private-string patterns live untracked in .git/info/private-patterns (see tools/check_private_strings.py).
# The Microsoft Store `python` stub hangs, so a real interpreter is preferred (py launcher, then python3).
for PY in py python3 python; do
  if command -v "$PY" >/dev/null 2>&1 && timeout 5 "$PY" -c "import sys" >/dev/null 2>&1; then
    "$PY" -B tools/check_no_game_files.py --staged || exit 1
    exec "$PY" -B tools/check_private_strings.py
  fi
done
echo "pre-commit: no Python found to run the commit guards" >&2
exit 1
